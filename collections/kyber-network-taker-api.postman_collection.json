          "request": {
            "name": "Request Operator Signature For Maker Orders",
            "description": {
              "content": "Takers will need to request for KyberSwap Operator signature for target Maker orders which they are planning to fill. The returned operator signature will be required when encoding the Taker fill order for both `/read-ks/api/v1/encode/fill-batch-orders-to` and `/read-ks/api/v1/encode/fill-order-to`.",
              "type": "text/plain"
            },
            "url": {
