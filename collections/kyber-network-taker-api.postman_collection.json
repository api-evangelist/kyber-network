                "api",
                "v1",
                "orders",
                "operator-signature"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chainId",
                  "value": "<string>",
                  "description": "(Required) The chainId on which the order is being filled. Only supports EVM chains."
                },
                {
                  "disabled": false,
                  "key": "orderIds",
                  "value": "<string>",
                  "description": "(Required) The order IDs to be cancelled gaslessly."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
